# ---- Already set on Render (reused) ----
DISCORD_TOKEN=
# Optional but recommended. Keeps settings, history and state across redeploys.
MONGO_URI=
# Render sets PORT by itself.
# PORT=8080

# ---- Channels and roles are NOT set here ----
# In Discord, run:  /setup log action:<log> channel_id:<id>
#                   /setup role service:<service> role:<role>
# /setup view shows the current settings.

# Only this user can run owner commands (/setup, /reactionrole, /botstatus). Default shown.
# BOT_OWNER_ID=1219266886143967245

# Optional fallback role pinged for every incident (a role set with /setup role replaces it).
# ALERT_ROLE_ID=

# Comma separated. Matched against Roblox's service names (spaces/case ignored).
# "Authentication" is not a Roblox component, so it is matched against incident text.
# TRACKED_SERVICES=Website,Game Join,Avatar,Marketplace,Data Store,Authentication

# tracked = only alert for TRACKED_SERVICES, all = alert for every Roblox service.
# ALERT_SCOPE=tracked

# ---- Roblox status page ----
# How often to check (seconds, minimum 15). 300 uses 5x less bandwidth.
# POLL_INTERVAL_SECONDS=60
# Refresh the live status message at least this often even if nothing changed (seconds).
# STATUS_REFRESH_SECONDS=300
# An incident must be gone this many checks in a row before it counts as resolved.
# RESOLVE_CONFIRM_POLLS=2
# Announce incidents that are already running the very first time the bot starts.
# NOTIFY_ON_STARTUP=false

# ---- Direct checks of roblox.com and the APIs (Website Status / API Status logs) ----
# HEALTH_CHECKS=true
# HEALTH_INTERVAL_SECONDS=120
# HEALTH_FAIL_THRESHOLD=3
# HEALTH_TIMEOUT_SECONDS=15
# Non-Roblox sites used to tell "Roblox is down" from "this host has no internet".
# HEALTH_CONTROL_URLS=https://discord.com/api/v10/gateway,https://www.cloudflare.com/cdn-cgi/trace
# Name=url pairs. A target named "Website" reports to Website Status, all others to API Status.
# HEALTH_TARGETS=Website=https://www.roblox.com/,Authentication=https://auth.roblox.com/v2/login,Users API=https://users.roblox.com/v1/users/1,Games API=https://games.roblox.com/v1/games?universeIds=1

# ---- Roblox news (Roblox Updates log) ----
# NEWS_ENABLED=true
# NEWS_POLL_MINUTES=30
# Name=feed-url pairs (RSS or Atom). If a default is wrong, /botstatus shows it as failing.
# NEWS_FEEDS=Roblox Blog=https://blog.roblox.com/feed/,DevForum Updates=https://devforum.roblox.com/c/updates/45.rss

# ---- Message mirror (needs the Message Content Intent in the Developer Portal) ----
# MIRROR_ENABLED=true
# MIRROR_CHANNEL_ID=1573743378368176148
# MIRROR_USER_ID=1219266886143967245

# ---- Member count in the bot's custom status ----
# MEMBER_COUNT_ENABLED=true
# MEMBER_COUNT_GUILD_ID=1573644874077708438

# ---- Roblox profile lookup ----
# Optional .ROBLOSECURITY cookie (use a throwaway account). Only needed for the online status.
# ROBLOX_COOKIE=

# ---- Advanced ----
# ROBLOX_STATUS_API_URL=https://4277980205320394.hostedstatus.com/1.0/status/59db90dbcdeb2f04dadcf16d
# ROBLOX_STATUS_PAGE_URL=https://status.roblox.com
# MONGO_DB_NAME=utility_bot
# DATA_DIR=./data
# HISTORY_LIMIT=200

# Economy tracker (limited item market)
# ECONOMY_ENABLED=true
# ECONOMY_POLL_MINUTES=30
# ECONOMY_MOVE_PERCENT=10
# ECONOMY_MIN_RAP=1000
# ECONOMY_KEYWORDS=robux,devex,marketplace,limited
